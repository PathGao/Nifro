            "state": "translated",
            "value": "切换"
          }
        }
      }
    },
    "Turn this off while logging in to a website, since the login may navigate to a page you want to stay in Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录网站时先关掉它——登录过程可能跳到别的页面，而你希望那一页留在 Nifro 里。"
          }
        }
      }
    },
