    "Move the wallpaper until it shows what you want. Drag or scroll to move it, pinch to zoom.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在壁纸上摆一个取景框：拖动或滚动移动它，捏合改大小。框住的部分会填满整个屏幕。"
          }
        }
      }
    },
    "Move to the main display when unplugged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拔掉后移到主显示器"
          }
        }
