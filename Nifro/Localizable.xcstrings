      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认播放列表"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Delete %@?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除「%@」？"
          }
        }
      }
    },
    "Deletes every playlist and every website, along with their cookies, caches, thumbnails and each page's remembered position and zoom.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除每个播放列表和每个网站，连同它们的 Cookie、缓存、缩略图，以及每个页面记住的位置和缩放。"
          }
        }
      }
    },
    "Delete…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除…"
          }
        }
      }
    },
    "Dim while another app is in front": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用在前时变暗"
          }
        }
      }
    },
    "Dimmed to": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变暗到"
          }
        }
      }
    },
    "Don't Keep": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保留"
          }
        }
      }
    },
