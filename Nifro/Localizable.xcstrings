    "When in dark mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式下"
          }
        }
      }
    },
    "Whether this website may make noise, remembered per website; it mutes the page's audio and video elements, not sound made with the Web Audio API.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个网站能不能出声，按网站分别记住；静音的是页面里的音频和视频元素，不包括用 Web Audio API 生成的声音。"
          }
        }
      }
    },
