      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音"
          }
        }
      }
    },
    "Starts Nifro when you log in, so the wallpaper is already up when you reach the desktop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动 Nifro，你到桌面时壁纸已经在了。"
          }
        }
      }
    },
    "Staying on this website": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定在这个网站"
