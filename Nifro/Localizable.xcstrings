{
  "sourceLanguage": "en",
  "strings": {
    "${shouldToggle} Nifro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "${shouldToggle} Nifro"
          }
        }
      }
    },
    "${shouldToggle} Nifro ${isEnabled}": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "${shouldToggle} Nifro ${isEnabled}"
          }
        }
      }
    },
    "%@ copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 副本"
          }
        }
      }
    },
    "%@× at %lld%%, %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@× at %2$lld%%, %3$lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@× 位于 %lld%%, %lld%%"
          }
        }
      }
    },
    "Wallpaper-ready pages with their recommended settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合做壁纸的网页，已附带推荐设置。"
          }
        }
      }
    },
    "A page that needs a resolution can take “[[screenWidth]]” and “[[screenHeight]]” in the address, which Nifro replaces with the wallpaper's size on that display.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要分辨率的页面可以在地址里写「[[screenWidth]]」和「[[screenHeight]]」，Nifro 会把它们替换成壁纸在那块屏幕上的尺寸。"
          }
        }
      }
    },
    "Scheduled reloads return a page to the start. Turn this on to restore its previous position.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时刷新会让页面回到开头。开启后，Nifro 会恢复刷新前的位置。"
          }
        }
      }
    },
    "Action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作"
