      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Double-click a website in the list to edit it, toggle dark mode, add custom CSS/JavaScript, and more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表里双击一个网站即可编辑：切换深色模式、加自定义 CSS/JavaScript，等等。"
          }
        }
      }
    },
    "Drag or scroll to move the frame · pinch to resize · Return to keep · Esc to cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动或滚动移动取景框 · 捏合改大小 · 回车保留 · Esc 取消"
          }
        }
      }
    },
