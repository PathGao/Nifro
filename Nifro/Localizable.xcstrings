            "value": "允许自签名证书"
          }
        }
      }
    },
    "Rotate between websites every": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮换间隔"
          }
        }
      }
    },
    "Add ${url} to Nifro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 ${url} 添加到 Nifro"
          }
        }
      }
    },
    "${shouldToggle} Nifro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "${shouldToggle} Nifro"
          }
        }
      }
    },
    "${shouldToggle} Nifro ${isEnabled}": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "${shouldToggle} Nifro ${isEnabled}"
          }
        }
      }
    },
    "Remove websites ${websites}": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除网站 ${websites}"
          }
        }
      }
    },
    "Set current website to ${website}": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把当前网站设为 ${website}"
          }
        }
      }
    },
    "You could, for example,": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比如，你可以让它"
          }
        }
      }
    },
    "show the time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示时间。"
          }
        }
      }
    },
    "Returns the websites in Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 Nifro 里的网站列表。"
          }
        }
      }
    },
    "Sets the enabled state of Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 Nifro 的启用状态。"
          }
        }
      }
    },
    "Toggles “Browsing Mode” for Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 Nifro 的「浏览模式」。"
          }
        }
      }
    },
    "Reloads the current website in Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载 Nifro 当前的网站。"
          }
        }
      }
    },
    "Returns the current website in Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 Nifro 当前的网站。"
          }
        }
      }
    },
    "Get the current enabled state of Nifro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取 Nifro 当前的启用状态"
          }
        }
      }
    },
    "Removes the given websites from Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Nifro 中移除指定的网站。"
          }
        }
      }
    },
    "Report a Problem or Request a Feature…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告问题或提出需求…"
          }
        }
      }
    },
    "Browsing mode always uses full opacity.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览模式下始终完全不透明。"
          }
        }
      }
    },
    "Nifro is open source under the MIT licence.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nifro 以 MIT 许可开源。"
          }
        }
      }
    },
    "Returns whether Nifro is currently enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 Nifro 当前是否启用。"
          }
        }
      }
    },
    "Clears all cookies, local storage, caches, etc.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除所有 Cookie、本地存储、缓存等。"
          }
        }
      }
    },
    "Switches Nifro to a random website in the list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到列表里的随机一个网站。"
          }
        }
      }
    },
    "Switches Nifro to the next website in the list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到列表里的下一个网站。"
          }
        }
      }
    },
    "Switches Nifro to the previous website in the list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到列表里的上一个网站。"
          }
        }
      }
    },
    "Adds a website to Nifro.\n\nReturns the added website.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Nifro 添加一个网站。\n\n返回添加的网站。"
          }
        }
      }
    },
    "^[%lld site](inflect: true) · up to date with GitHub": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个站点 · 已与 GitHub 同步"
          }
        }
      }
    },
    "^[%lld site](inflect: true) · bundled copy, could not reach GitHub": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个站点 · 内置副本，连不上 GitHub"
          }
        }
      }
    },
    "Points the stored website at the URL currently loaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把保存的网址改成当前正在显示的地址"
          }
        }
      }
    },
    "Sets the current website in Nifro to the given website.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Nifro 的当前网站设为指定的网站。"
          }
        }
      }
    },
    "Drag a rectangle over the wallpaper to keep only that part of the page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在壁纸上拖一个框，只保留网页的那一部分。"
          }
        }
      }
    },
    "Keep the website above all other windows while browsing mode is active.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览模式期间让网站保持在所有窗口之上。"
          }
        }
      }
    },
    "Drag to choose the part of the page to fill the screen with.  Esc to cancel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动选择要铺满屏幕的那一部分。  按 Esc 取消。"
          }
        }
      }
    },
    "While disabled, Nifro will display the website on the space that is active at launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，Nifro 只在启动时所在的那个桌面显示网站。"
          }
        }
      }
    },
    "Pages that work well as wallpapers. Adding one brings its recommended settings with it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合当壁纸的网页。添加时会一并带上它推荐的设置。"
          }
        }
      }
    },
    "The page keeps running. Necessary for anything that animates or that you want to click.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页持续运行。有动画或者你想点它，就得用这个。"
          }
        }
      }
    },
    "Each website can live on its own screen. “Default display” follows the choice in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个网站可以待在自己的屏幕上。「默认显示器」跟随设置里的选择。"
          }
        }
      }
    },
    "If you don't currently see the website, you might need to hide some windows to reveal the desktop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果现在看不到网站，可能需要收起一些窗口把桌面露出来。"
          }
        }
      }
    },
    "Moves to the next website on each display in turn. Websites with hours set are skipped outside them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每块屏幕上依次切到下一个网站。设了时段的网站在时段外会被跳过。"
          }
        }
      }
    },
    "Creates a fake dark mode for websites without a native dark mode by inverting all the colors on the website.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对没有原生深色模式的网站反转全部颜色，做出一个假的深色模式。"
          }
        }
      }
    },
    "The centre is a position on the page, from its top-left corner. The zoom is how many times that part is enlarged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中心是网页上的位置，从左上角算起。缩放是那一部分被放大的倍数。"
          }
        }
      }
    },
    "Whether this website is allowed to make noise. Remembered per website, so a clock stays silent and a live stream does not.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个网站能不能出声。按网站分别记住，所以时钟保持安静而直播不会。"
          }
        }
      }
    },
    "The page is loaded, photographed and closed again on each refresh. Costs almost nothing between refreshes, but nothing moves.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次刷新时加载网页、拍一张、再关掉。两次刷新之间几乎不耗资源，但什么都不会动。"
          }
        }
      }
    },
    "Useful with rotation. A news page in the morning, something calmer at night. A window that runs past midnight, 22 to 6, works.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配合轮换很好用。早上放新闻，晚上放安静点的。跨过午夜的时段（22 到 6）也可以。"
          }
        }
      }
    },
    "Browsing Mode lets you temporarily interact with the website. For example, to log into an account or scroll to a specific position on the website.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览模式让你临时操作网站，比如登录账号，或者把网页滚到某个位置。"
          }
        }
      }
    },
    "Watches what the page actually does for a minute, then keeps rendering it or switches to stills. It changes its mind again if the page starts moving.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先观察网页一分钟到底在做什么，然后决定继续渲染还是改用静图。如果网页开始动，它会改回来。"
          }
        }
      }
    },
    "Muting is done by keeping every audio and video element on the page muted. It covers media elements, not sound a page generates with the Web Audio API.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音的做法是把网页上每个音频和视频元素都保持静音。它覆盖媒体元素，不覆盖网页用 Web Audio API 生成的声音。"
          }
        }
      }
    },
    "Forces the website to use its print styles (“@media print”) if any. Some websites have a simpler presentation for printing, for example, Google Calendar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制网站使用它的打印样式（「@media print」），如果有的话。有些网站的打印版式更简洁，比如 Google 日历。"
          }
        }
      }
    },
    "The site gallery is a list of pages that work well as wallpapers, each with the settings that make it work. Adding one takes a single file, no Swift and no Xcode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点图库是一份适合当壁纸的网页清单，每条都带着让它好用的那些设置。添加一条只需要一个文件，不用写 Swift，也不用开 Xcode。"
          }
        }
      }
    },
    "Lets you use the page without switching to Browsing Mode. The window then stops letting clicks through, so your desktop icons sit behind it, and the page has to keep rendering.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用切到浏览模式就能操作网页。代价是窗口不再让点击穿过去，桌面图标会被挡在后面，而且网页必须一直渲染。"
          }
        }
      }
    },
    "A video page is mostly navigation, recommendations and comments. This is the address of the player on its own, so the video fills the wallpaper without cropping or hiding anything.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频页面大部分是导航、推荐和评论。这是播放器单独的地址，视频会直接铺满壁纸，不用裁剪也不用隐藏任何东西。"
          }
        }
      }
    },
    "Fills the screen with one part of the page, cutting away navigation bars, borders and whatever else surrounds it. Use “Choose Region…” in the menu to frame it by dragging over the wallpaper.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用网页的一部分铺满屏幕，导航栏、边框和周围其他东西都被去掉。用菜单里的「选择区域…」在壁纸上拖着框。"
          }
        }
      }
    },
    "Fades the wallpaper back while you work elsewhere, and brings it up again when you click the desktop. A page bright enough to enjoy when you look at it is often too loud behind a document you are reading.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在别处工作时让壁纸淡下去，点桌面时再亮回来。一个看着舒服的网页，垫在你正在读的文档后面往往就太吵了。"
          }
        }
      }
    },
    "If a website requires login, you should disable this setting while logging in as the website might require you to navigate to a different page, and you don't want that to open in a browser instead of Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果网站需要登录，登录期间应该关掉这个设置：网站可能要求你跳转到别的页面，而你不希望那个页面开在浏览器里而不是 Nifro 里。"
          }
        }
      }
    },
    "Points at a WebKit content-blocking rule list somebody else maintains, for hiding cookie banners and ads. Nifro keeps no rules of its own, because blocklists go stale within weeks and keeping one working is a full-time job.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指向别人维护的一份 WebKit 内容拦截规则，用来挡掉 Cookie 横幅和广告。Nifro 自己不维护规则——拦截列表几周就会过期，让它一直有效是一份全职工作。"
          }
        }
      }
    },
    "Derived from [Plash](https://github.com/sindresorhus/Plash) by Sindre Sorhus, from its last MIT-licensed release. Plash is still developed and still on the App Store; Nifro is a separate project and uses none of its branding or artwork.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "衍生自 Sindre Sorhus 的 [Plash](https://github.com/sindresorhus/Plash)，取自它最后一个 MIT 许可的版本。Plash 仍在开发、仍在 App Store 上；Nifro 是一个独立项目，没有使用它的任何品牌或美术资源。"
          }
        }
      }
    },
    "When other windows cover most of the wallpaper, Nifro shrinks the window to whatever is still visible, such as the strip behind the Dock, and keeps rendering only that. When nothing is visible it holds the last frame. Turn this off to keep drawing the whole page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当其他窗口盖住大部分壁纸时，Nifro 把窗口缩到还露在外面的那一块（比如程序坞后面那条），只渲染那一块。什么都看不见时就停在最后一帧。关掉这个开关会一直画整张网页。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
