    "Next website": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个网站"
          }
        }
      }
    },
    "Nifro is in English until you pick a language here, and a half-translated language falls back to English rather than showing anything raw.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你从这里选之前 Nifro 都是英文；翻译不全的语言会退回英文，而不是显示原始标识。"
          }
        }
      }
    },
    "Nifro is open source under the MIT licence.": {
      "localizations": {
