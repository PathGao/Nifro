    "Moves to the next website on each display in turn. Websites with hours set are skipped outside them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每块屏幕上依次切到下一个网站。设了时段的网站在时段外会被跳过。"
          }
        }
      }
    },
    "Multi-display support ›" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多显示器支持 ›"
          }
        }
