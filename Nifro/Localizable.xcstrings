    "Checking for new entries…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查新条目…"
          }
        }
      }
    },
    "Checks once a day in the background and puts a download button in the panel when there is something newer; nothing is ever downloaded or installed for you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在后台检查一次，有更新时在面板里放一个下载按钮；从不替你下载或安装任何东西。"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
    "Choose Local Website": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择本地网页"
          }
        }
      }
    },
    "Choose Region…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择区域…"
          }
        }
      }
    },
    "Choose a directory with a “index.html” file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个含有「index.html」文件的目录。"
          }
        }
      }
    },
    "Choose region": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择区域"
          }
        }
      }
    },
    "Clear Data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除数据"
          }
        }
      }
    },
    "Clear all website data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除所有网站数据"
          }
        }
      }
    },
    "Clear all website data?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除所有网站数据吗？"
          }
        }
      }
    },
    "Clears cookies, local storage, caches, thumbnails and each page's remembered position and zoom; your websites and their settings are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 Cookie、本地存储、缓存、缩略图，以及每个页面记住的位置和缩放；你的网站和它们的设置会保留。"
          }
        }
      }
    },
    "Click to edit this website.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点这里编辑这个网站。"
          }
        }
      }
    },
    "Clickable on the desktop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面上可点击"
          }
        }
      }
    },
    "Content blocking rules": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容拦截规则"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Copies this website's settings as text for pasting into an issue, reporting the CSS and JavaScript by size rather than by content.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个网站的设置复制成文本，方便粘进 issue；CSS 和 JavaScript 只报大小，不报内容。"
          }
        }
      }
    },
    "Copy Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制设置"
          }
        }
      }
    },
