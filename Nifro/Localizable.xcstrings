    },
    "Error: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出错：%@"
          }
        }
      }
    },
    "Fades the wallpaper back while you work elsewhere, and brings it up again when you click the desktop. A page bright enough to enjoy when you look at it is often too loud behind a document you are reading." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在别处工作时让壁纸淡下去，点桌面时再亮回来。一个看着舒服的网页，垫在你正在读的文档后面往往就太吵了。"
          }
        }
      }
    },
    "Feedback Welcome" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎反馈"
          }
        }
      }
    },
    "Fills the screen with one part of the page, cutting away navigation bars, borders and whatever else surrounds it. Use “Choose Region…” in the menu to frame it by dragging over the wallpaper." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用网页的一部分铺满屏幕，导航栏、边框和周围其他东西都被去掉。用菜单里的「选择区域…」在壁纸上拖着框。"
          }
        }
      }
    },
    "For websites that do not set their own. A website with its own schedule — set in its settings — ignores this." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供没有自己设定的网站使用。设了自己节奏的网站（在该网站的设置里）不受这里影响。"
          }
        }
      }
    },
    "Forces the website to use its print styles (“@media print”) if any. Some websites have a simpler presentation for printing, for example, Google Calendar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制网站使用它的打印样式（「@media print」），如果有的话。有些网站的打印版式更简洁，比如 Google 日历。"
          }
        }
      }
    },
    "From" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从"
          }
        }
      }
    },
