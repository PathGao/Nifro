    "Report a Problem or Request a Feature…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告问题或提出需求…"
          }
        }
      }
    },
    "Report a problem": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告问题"
          }
        }
      }
    },
    "Reset: every setting, every keyboard shortcut, and what each display is showing. Every display goes back to the default playlist and its first website. There is no undo.\n\nKept: your websites and playlists, your logins, the language you picked, and whether Nifro launches at login.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置：所有设置、所有键盘快捷键，以及每个显示器正在显示的内容；每个显示器都会回到默认播放列表和它的第一个网站。无法撤销。\n\n保留：你的网站和播放列表、你的登录状态、你选的语言，以及 Nifro 是否随登录启动。"
          }
        }
      }
    },
    "Restore All Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还原所有设置"
          }
        }
      }
    },
    "Restore all settings?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要还原所有设置吗？"
          }
        }
      }
    },
    "Restore page position after reloading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新后恢复页面位置"
          }
        }
      }
    },
    "Returns the current website in Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 Nifro 当前的网站。"
          }
        }
      }
    },
    "Returns the websites in Nifro.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 Nifro 里的网站列表。"
