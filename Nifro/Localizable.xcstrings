            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "Not Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        }
      }
    },
    "Launch Nifro again to bring the menu bar icon back for 5 seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次启动 Nifro，菜单栏图标会回来 5 秒。"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        }
      }
    },
    "Lets you temporarily interact with the website, to log in or scroll to a particular place.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你临时操作网站，比如登录，或者滚到某个位置。"
          }
        }
      }
    },
    "Lets web pages and video players use macOS fullscreen. Nifro appears in the Dock while this mode is on. Reopen Nifro after changing this setting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许网页和视频播放器使用 macOS 全屏。启用后，Nifro 会显示在程序坞中。更改此设置后，请重新打开 Nifro。"
          }
        }
      }
    },
	"Load this page even if macOS does not trust its certificate. Use this only for devices on a trusted network.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 macOS 不信任该证书，也加载此页面。仅应对受信任网络中的设备启用此选项。"
          }
        }
      }
    },
    "Local Website…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网页…"
          }
