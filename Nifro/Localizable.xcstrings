      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留"
          }
        }
      }
    },
    "Keep changes?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留更改吗？"
          }
        }
      }
    },
    "Keep the website above all other windows while browsing mode is active.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览模式期间让网站保持在所有窗口之上。"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "zh-Hans": {
