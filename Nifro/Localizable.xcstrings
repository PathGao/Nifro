    "Deletes every playlist and every website, along with their cookies, caches, thumbnails and each page's remembered position and zoom.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除每个播放列表和每个网站，连同它们的 Cookie、缓存、缩略图，以及每个页面记住的位置和缩放。"
          }
        }
      }
    },
