    "Choose the language Nifro uses. Any untranslated text stays in English.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Nifro 使用的语言。尚未翻译的文字会继续显示为英文。"
