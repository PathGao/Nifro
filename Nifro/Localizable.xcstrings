    "Check for updates automatically": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新"
          }
        }
      }
    },
    "Checking for new entries…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查新条目…"
          }
        }
      }
    },
    "Checks once a day in the background and puts a download button in the panel when there is something newer; nothing is ever downloaded or installed for you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在后台检查一次，有更新时在面板里放一个下载按钮；从不替你下载或安装任何东西。"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
