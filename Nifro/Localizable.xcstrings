      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "${shouldToggle} Nifro ${isEnabled}"
          }
        }
      }
    },
    "%@": {},
    "%@ copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 副本"
          }
        }
      }
    },
    "%@× at %lld%%, %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@× at %2$lld%%, %3$lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@× 位于 %lld%%, %lld%%"
          }
        }
      }
    },
    "A list of pages that work well as wallpapers, each with the settings that make it work; adding one takes a single file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份适合当壁纸的网页清单，每条都带着让它好用的设置；添加一条只需要一个文件。"
          }
        }
      }
    },
    "A page that needs a resolution can take “[[screenWidth]]” and “[[screenHeight]]” in the address, which Nifro replaces with the wallpaper's size on that display.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要分辨率的页面可以在地址里写「[[screenWidth]]」和「[[screenHeight]]」，Nifro 会把它们替换成壁纸在那块屏幕上的尺寸。"
          }
        }
      }
    },
    "A page that reloads on a timer starts over; this puts back where it was scrolled or moved to.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时刷新会让页面从头开始，这个开关把它滚动或移动到的位置放回去。"
          }
        }
      }
    },
