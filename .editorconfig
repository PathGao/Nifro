root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Swift is written with tabs here, which is what Xcode does by default and what SwiftLint checks.
[*.swift]
indent_style = tab

# YAML forbids tabs outright, and adding a site entry — the contribution this project asks for most —
# is editing a YAML file. An editor told to indent with tabs turns that into a syntax error.
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
